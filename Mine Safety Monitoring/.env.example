# STRATA local configuration. Copy to .env and edit if needed.
# Every value below is optional; the defaults are shown.

# Local Ollama server. Only loopback addresses (127.0.0.1 / localhost / ::1)
# are accepted unless OLLAMA_ALLOW_NON_LOOPBACK=1.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Any model you have pulled with `ollama pull <name>`.
OLLAMA_MODEL=qwen2.5:1.5b

# Max time for one analysis (ms). The first run after starting Ollama
# also loads the model into memory, so keep this generous on slow CPUs.
OLLAMA_TIMEOUT_MS=180000

# Context window given to the model, and sampling temperature.
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2

# Allow Ollama on another machine on your own network (not recommended).
# OLLAMA_ALLOW_NON_LOOPBACK=1

# Web app address. Keep 127.0.0.1 so the app is not reachable from other
# computers. The port is fixed so saved runs (browser storage) stay attached
# to the same address.
HOST=127.0.0.1
PORT=8080

# Extra host names allowed to reach the app (comma-separated), e.g. a
# hostname you mapped to 127.0.0.1 yourself. Leave empty normally.
# ALLOWED_HOSTS=
